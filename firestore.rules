rules_version = '2';

// Reglas de la base del Tablero de Producción Kacrea.
// Firebase → Firestore Database → Reglas → pegar esto → Publicar.
// Solo lee y escribe quien abrió el tablero (sesión anónima creada por la página).

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
